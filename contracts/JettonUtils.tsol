pragma ever-solidity >= 0.71.0;

library JettonUtils {
    // Jetton Wallet
    uint32 constant TRANSFER_FUNCTION_ID = 0xf8a7ea5;
    uint32 constant INTERNAL_TRANSFER_FUNCTION_ID = 0x178d4519;
    uint32 constant BURN_FUNCTION_ID = 0x595f07bc;
    uint32 constant UPGRADE_WALLET_FUNCTION_ID = 0x7d6ff254;

    // Jetton Minter
    uint32 constant PROVIDE_WALLET_ADDRESS_FUNCTION_ID = 0x2c76b973;
    uint32 constant PROVIDE_INFO_FUNCTION_ID = 0x13e5c11a;
    uint32 constant MINT_FUNCTION_ID = 0x00000015;
    uint32 constant SET_ADMIN_FUNCTION_ID = 0x00000003;
    uint32 constant SET_META_FUNCTION_ID = 0x00000004;
    uint32 constant UPGRADE_MINTER_FUNCTION_ID = 0x17230c3a;
    uint32 constant SET_WALLET_CODE_FUNCTION_ID = 0x71ede38c;
    uint32 constant DEPLOY_WALLET_FUNCTION_ID = 0x6f8fc501;
    uint32 constant DRAIN_FUNCTION_ID = 0x1ea60eff;

    // Callbacks
    uint32 constant TAKE_WALLET_ADDRESS_FUNCTION_ID = 0xd1735400;
    uint32 constant TRANSFER_NOTIFICATION_FUNCTION_ID = 0x7362d09c;
    uint32 constant EXCESSES_FUNCTION_ID = 0xd53276db;
    uint32 constant ON_ACCEPT_TOKENS_BURN_FUNCTION_ID = 0x68088d9b;

    function buildMinterMetadata(
        string _name,
        string _symbol,
        uint8 _decimals,
        uint256 _chainId,
        uint160 _baseToken
    ) public returns (TvmCell) {
        TvmBuilder info;

        info.store(_name);
        info.store(_symbol);
        info.store(_decimals);
        info.store(_chainId);
        info.store(_baseToken);

        return info.toCell();
    }

    function buildMinterStateInit(
        address _admin,
        string _name,
        string _symbol,
        uint8 _decimals,
        uint256 _chainId,
        uint160 _baseToken,
        TvmCell _walletCode,
        TvmCell _minterCode,
        TvmCell _platformCode
    ) public returns (TvmCell) {
        TvmBuilder data;

        data.storeTons(varUint16(0)); // supply
        data.store(_admin);
        data.store(
            buildMinterMetadata(
                _name,
                _symbol,
                _decimals,
                _chainId,
                _baseToken
            )
        );
        data.store(_walletCode);
        data.store(_platformCode);
        data.store(uint32(1));

        return tvm.buildStateInit(_minterCode, data.toCell());
    }

    function deployMinter(
        address _admin,
        string _name,
        string _symbol,
        uint8 _decimals,
        uint256 _chainId,
        uint160 _baseToken,
        TvmCell _walletCode,
        TvmCell _minterCode,
        TvmCell _platformCode,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public returns (address) {
        TvmCell stateInit = buildMinterStateInit(
            _admin,
            _name,
            _symbol,
            _decimals,
            _chainId,
            _baseToken,
            _walletCode,
            _minterCode,
            _platformCode
        );
        address minter = address(tvm.hash(stateInit));

        minter.transfer({
            stateInit: stateInit,
            value: _value,
            flag: _flag,
            bounce: _bounce
        });

        return minter;
    }

    function walletOf(
        address _minter,
        uint64 _callId,
        address _walletOwner,
        bool _addWalletOwnerToCallback,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder body;

        body.store(PROVIDE_WALLET_ADDRESS_FUNCTION_ID);
        body.store(_callId);
        body.store(_walletOwner);
        body.store(_addWalletOwnerToCallback);

        _minter.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }

    function getInfo(
        address _minter,
        uint64 _callId,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder body;

        body.store(PROVIDE_INFO_FUNCTION_ID);
        body.store(_callId);

        _minter.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }

    function mint(
        address _minter,
        uint64 _callId,
        address _recipient,
        varUint16 _amount,
        varUint16 _deployWalletValue,
        varUint16 _callbackValue,
        optional(TvmCell) _payload,
        address _remainingGasTo,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder payload;

        payload.store(INTERNAL_TRANSFER_FUNCTION_ID);
        payload.store(_callId);
        payload.store(_amount);
        payload.store(address(this)); // token sender
        payload.store(_remainingGasTo);
        payload.store(_callbackValue);
        payload.store(_payload);

        TvmBuilder body;

        body.store(MINT_FUNCTION_ID);
        body.store(_callId);
        body.store(_recipient);
        body.store(_deployWalletValue);
        body.store(payload.toCell());

        _minter.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }

    function transferJettons(
        address _wallet,
        uint64 _callId,
        address _recipient,
        varUint16 _amount,
        varUint16 _callbackValue,
        optional(TvmCell) _payload,
        address _remainingGasTo,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder body;
        optional(TvmCell) nullCell;

        body.store(TRANSFER_FUNCTION_ID);
        body.store(_callId);
        body.store(_amount);
        body.store(_recipient);
        body.store(_remainingGasTo);
        body.store(nullCell);
        body.store(_callbackValue);
        body.store(_payload);

        _wallet.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }

    function burn(
        address _wallet,
        uint64 _callId,
        varUint16 _amount,
        address _callbackTo,
        optional(TvmCell) _payload,
        optional(address) _remainingGasTo,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder body;

        body.store(BURN_FUNCTION_ID);
        body.store(_callId);
        body.store(_amount);
        body.store(_callbackTo);
        body.store(_payload);

        if (_remainingGasTo.hasValue()) {
            body.store(_remainingGasTo.get());
        }

        _wallet.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }

    function setAdmin(
        address _minter,
        uint64 _callId,
        address _newAdmin,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder body;

        body.store(SET_ADMIN_FUNCTION_ID);
        body.store(_callId);
        body.store(_newAdmin);

        _minter.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }

    function setMeta(
        address _minter,
        uint64 _callId,
        TvmCell _newMeta,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder body;

        body.store(SET_META_FUNCTION_ID);
        body.store(_callId);
        body.store(_newMeta);

        _minter.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }

    function setWalletCode(
        address _minter,
        uint64 _callId,
        TvmCell _newWalletCode,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder body;

        body.store(SET_WALLET_CODE_FUNCTION_ID);
        body.store(_callId);
        body.store(_newWalletCode);

        _minter.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }

    function upgradeMinter(
        address _minter,
        uint64 _callId,
        TvmCell _newMinterCode,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder body;

        body.store(UPGRADE_MINTER_FUNCTION_ID);
        body.store(_callId);
        body.store(_newMinterCode);

        _minter.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }

    function upgradeWallet(
        address _wallet,
        uint64 _callId,
        address _remainingGasTo,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder body;

        body.store(UPGRADE_WALLET_FUNCTION_ID);
        body.store(_callId);
        body.store(_remainingGasTo);

        _wallet.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }

    function deployWallet(
        address _minter,
        uint64 _callId,
        address _walletOwner,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder body;

        body.store(DEPLOY_WALLET_FUNCTION_ID);
        body.store(_callId);
        body.store(_walletOwner);

        _minter.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }

    function drain(
        address _minterOrWallet,
        uint64 _callId,
        address _remainingGasTo,
        uint128 _value,
        uint16 _flag,
        bool _bounce
    ) public {
        TvmBuilder body;

        body.store(DRAIN_FUNCTION_ID);
        body.store(_callId);
        body.store(_remainingGasTo);

        _minterOrWallet.transfer({
            body: body.toCell(),
            value: _value,
            flag: _flag,
            bounce: _bounce
        });
    }
}
